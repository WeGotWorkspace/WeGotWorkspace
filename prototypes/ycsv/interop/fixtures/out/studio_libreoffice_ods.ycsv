---
ycsv_version: 1
defs:
  btw_tarief: =instellingen!$B$1
  cats: =categorieën!$id1:$korting$3
  omzet: =q1_overzicht!$B$3
sheets:
  - ref: producten
    name: Producten
    header: true
    columns:
      - ref: product
        name: Product
        type: string
      - ref: categorie
        name: Categorie
        type: string
      - ref: prijs
        name: Prijs
      - ref: aantal
        name: Aantal
        type: number
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: "0"
      - ref: totaal
        name: Totaal
      - ref: btw
        name: BTW
      - ref: datum
        name: Datum
        type: date
        excel_format: m/d/yy
      - ref: marge
        name: Marge
      - ref: actief
        name: Actief
        type: boolean
    notes:
      C1: Prijs per stuk, incl. korting
    cells:
      E6:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[Red]"-€ "#,##0.00'
      F6:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[Red]"-€ "#,##0.00'
      H6:
        type: percent
        minimumFractionDigits: 1
        maximumFractionDigits: 1
        excel_format: 0.0%
  - ref: categorieën
    name: Categorieën
    header: true
    columns:
      - ref: id
        name: Id
        type: string
      - ref: label
        name: Label
        type: string
      - ref: korting
        name: Korting
  - ref: instellingen
    name: Instellingen
    header: false
    columns:
      - ref: A
        type: string
      - ref: B
  - ref: q1_overzicht
    name: Q1 overzicht
    header: false
    columns:
      - ref: A
        type: string
      - ref: B
    merges:
      - A1:D1
    notes:
      A19: Sheet-level notitie
    cells:
      B3:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[Red]"-€ "#,##0.00'
      B4:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[Red]"-€ "#,##0.00'
      B5:
        type: percent
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: 0%
      B6:
        type: percent
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: 0%
      B8:
        type: number
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: "0"
      B9:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[Red]"-€ "#,##0.00'
      B10:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[Red]"-€ "#,##0.00'
      B11:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[Red]"-€ "#,##0.00'
      B12:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[Red]"-€ "#,##0.00'
      B13:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[Red]"-€ "#,##0.00'
      B16:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[Red]"-€ "#,##0.00'
      B17:
        type: date
        excel_format: dd"-"mm"-"yyyy
      B18:
        type: number
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: "0"
      B19:
        type: date
        excel_format: dd"-"mm"-"yyyy
      B20:
        type: number
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: "0"
      B25:
        type: date
        excel_format: dd"-"mm"-"yyyy
      B27:
        type: number
        notation: scientific
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: "0.00E+00"
      B28:
        type: number
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        useGrouping: true
        excel_format: '#,##0.00;"("#,##0.00")"'
      B29:
        type: time
        excel_format: hh":"mm
---
product,categorie,prijs,aantal,totaal,btw,datum,marge,actief
Appels,fruit,0.45,6,=prijs1*aantal1,=totaal1*btw_tarief,2026-01-05,0.18,true
Brood,bakkerij,2.99,2,=prijs2*aantal2,=totaal2*btw_tarief,2026-01-06,0.32,true
Melk,zuivel,1.19,3,=prijs3*aantal3,=totaal3*btw_tarief,2026-02-01,0.25,false
Kaas,zuivel,8.5,1,=prijs4*aantal4,=totaal4*btw_tarief,2026-02-28,0.41,true
Peren,fruit,0.6,12,=prijs5*aantal5,=totaal5*btw_tarief,2026-03-31,0.2,true
Totaal,,,,=SUM(totaal1:totaal5),=SUM(btw1:btw5),,=AVERAGE(marge1:marge5),
---
id,label,korting
fruit,Fruit,0.1
bakkerij,Bakkerij,0
zuivel,Zuivel,0.05
---
BTW tarief,0.21
---
Overzicht Q1 2026,
,
Kengetal,Waarde
Omzet (SUM over tab),=SUM(producten!totaal1:totaal5)
"Omzet incl. BTW, afgerond","=ROUND(B3*(1+btw_tarief),2)"
Korting fruit (VLOOKUP),"=VLOOKUP(""fruit"",cats,3,FALSE)"
Korting zuivel (XLOOKUP),"=XLOOKUP(""zuivel"",categorieën!id1:id3,categorieën!korting1:korting3,""?"")"
Label via INDEX/MATCH,"=IFERROR(INDEX(categorieën!$label1:$label$3,MATCH(""zuivel"",categorieën!$id1:$id$3,0)),""-"")"
Aantal fruit (COUNTIF),"=COUNTIF(producten!categorie1:categorie5,""fruit"")"
Omzet fruit actief (SUMIFS),"=SUMIFS(producten!totaal1:totaal5,producten!categorie1:categorie5,""fruit"",producten!actief1:actief5,TRUE)"
Gemiddelde prijs,=AVERAGE(producten!prijs1:prijs5)
SUMPRODUCT prijs x aantal,"=SUMPRODUCT(producten!prijs1:prijs5,producten!aantal1:aantal5)"
Hele kolom SUM(E:E) min totaal,=SUM(producten!totaal:totaal)-producten!totaal6
Absolute ref $C$2*D2,=producten!$prijs$1*producten!aantal1
Concat &,"=producten!product1&"" (""&producten!categorie1&"")"""
TEXTJOIN,"=TEXTJOIN("", "",TRUE,producten!product1:product3)"
Percent literal 50%*B4,=50%*B3
Eerste datum,=MIN(producten!datum1:datum5)
Dagen tussen eerste en laatste,=MAX(producten!datum1:datum5)-MIN(producten!datum1:datum5)
Einde maand (EOMONTH),"=EOMONTH(producten!datum1,0)"
Werkdagen (NETWORKDAYS),"=NETWORKDAYS(producten!datum1,producten!datum5)"
Datum als tekst (TEXT),"=TEXT(producten!datum1,""dd-mm-yyyy"")"
IF/AND,"=IF(AND(B3>10,B8<5),""ok"",""check"")"
Deling door nul,=1/0
IFERROR rond deling,"=IFERROR(1/0,""n.v.t."")"
Vandaag (volatile),=TODAY()
Tekst die op een getal lijkt,'007
Groot getal,100000000000000000000
"Negatief, boekhoudnotatie",-1234.5
Tijd,09:30:00
Hyperlink,"=HYPERLINK(""https://example.org/"",""WeGotWorkspace"")"
Rich text,vet en cursief
Fout als waarde,=NA()
