---
ycsv_version: 1
sheets:
  - ref: sheet1
    name: Sheet1
    header: true
    columns:
      - ref: Item
        type: string
        width: 84
      - ref: Bedrag
      - ref: Koers
      - ref: Gefilterd
    notes:
      Item1: Opmerking van een collega
    cells:
      Koers1:
        source_formula: =GOOGLEFINANCE("CURRENCY:EURUSD")
      Gefilterd1:
        source_formula: =FILTER(A2:B4,B2:B4>15)
      Koers2:
        source_formula: ="COMPUTED_VALUE"
      Gefilterd3:
        source_formula: =ARRAYFORMULA(B2:B4*2)
---
Item,Bedrag,Koers,Gefilterd
A,10,1.08,B
B,20,1.08,=Bedrag2*2
C,30,,20
Som,=SUM(Bedrag1:Bedrag3),,
