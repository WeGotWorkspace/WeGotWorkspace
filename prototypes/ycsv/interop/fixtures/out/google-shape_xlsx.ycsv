---
ycsv_version: 1
sheets:
  - ref: sheet1
    name: Sheet1
    header: true
    columns:
      - ref: item
        name: Item
        type: string
        width: 84
      - ref: bedrag
        name: Bedrag
      - ref: koers
        name: Koers
      - ref: gefilterd
        name: Gefilterd
    notes:
      A2: Opmerking van een collega
    cells:
      C2:
        source_formula: =GOOGLEFINANCE("CURRENCY:EURUSD")
      D2:
        source_formula: =FILTER(A2:B4,B2:B4>15)
      C3:
        source_formula: ="COMPUTED_VALUE"
      D4:
        source_formula: =ARRAYFORMULA(B2:B4*2)
---
item,bedrag,koers,gefilterd
A,10,1.08,B
B,20,1.08,=bedrag3*2
C,30,,20
Som,=SUM(bedrag2:bedrag4),,
