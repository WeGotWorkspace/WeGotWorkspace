---
ycsv_version: 1
defs:
  cats: =categorieën!$id$2:$korting$4
  btw_tarief: =instellingen!$B$1
  omzet: =q1_overzicht!$B$4
sheets:
  - ref: producten
    name: Producten
    header: true
    tab_color: "#2e7d32"
    freeze:
      rows: 1
      columns: 1
    columns:
      - ref: product
        name: Product
        type: string
        width: 132
      - ref: categorie
        name: Categorie
        type: string
        width: 84
      - ref: prijs
        name: Prijs
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€"\ #,##0.00;[Red]\-"€"\ #,##0.00'
        width: 72
      - ref: aantal
        name: Aantal
        type: number
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: "0"
        width: 54
      - ref: totaal
        name: Totaal
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€"\ #,##0.00;[Red]\-"€"\ #,##0.00'
        width: 84
      - ref: btw
        name: BTW
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€"\ #,##0.00;[Red]\-"€"\ #,##0.00'
        width: 72
      - ref: datum
        name: Datum
        type: date
        excel_format: dd-mm-yyyy
        width: 72
      - ref: marge
        name: Marge
        type: percent
        minimumFractionDigits: 1
        maximumFractionDigits: 1
        excel_format: 0.0%
        width: 54
      - ref: actief
        name: Actief
        type: boolean
        width: 48
    validate:
      - range: B2:B6
        list: =categorieën!$id$2:$id$4
      - range: D2:D6
        range_value:
          min: 0
          max: 1000
          integer: true
    notes:
      C2: Prijs per stuk, incl. korting
    cells:
      A1:
        style:
          bold: true
          fill: "#f5f5f5"
      B1:
        style:
          bold: true
          fill: "#f5f5f5"
      C1:
        style:
          bold: true
          fill: "#f5f5f5"
      D1:
        style:
          bold: true
          fill: "#f5f5f5"
      E1:
        style:
          bold: true
          fill: "#f5f5f5"
      F1:
        style:
          bold: true
          fill: "#f5f5f5"
      G1:
        style:
          bold: true
          fill: "#f5f5f5"
      H1:
        style:
          bold: true
          fill: "#f5f5f5"
      I1:
        style:
          bold: true
          fill: "#f5f5f5"
      A7:
        style:
          bold: true
      E7:
        style:
          bold: true
      F7:
        style:
          bold: true
      H7:
        style:
          bold: true
  - ref: categorieën
    name: Categorieën
    header: true
    columns:
      - ref: id
        name: Id
        type: string
      - ref: label
        name: Label
        type: string
      - ref: korting
        name: Korting
        type: percent
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: 0%
        width: 54
  - ref: instellingen
    name: Instellingen
    header: false
    hidden: true
    columns:
      - ref: A
        type: string
      - ref: B
        type: percent
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: 0%
  - ref: q1_overzicht
    name: Q1 overzicht
    header: false
    freeze:
      rows: 3
      columns: 0
    columns:
      - ref: A
        type: string
        width: 204
      - ref: B
        width: 108
      - ref: C
        width: 54
        hidden: true
      - ref: D
    merges:
      - A1:D1
    notes:
      A20: Sheet-level notitie
    cells:
      B4:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€"\ #,##0.00;[Red]\-"€"\ #,##0.00'
      B5:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€"\ #,##0.00;[Red]\-"€"\ #,##0.00'
      B6:
        type: percent
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: 0%
      B7:
        type: percent
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: 0%
      B9:
        type: number
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: "0"
      B10:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€"\ #,##0.00;[Red]\-"€"\ #,##0.00'
      B11:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€"\ #,##0.00;[Red]\-"€"\ #,##0.00'
      B12:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€"\ #,##0.00;[Red]\-"€"\ #,##0.00'
      B13:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€"\ #,##0.00;[Red]\-"€"\ #,##0.00'
      B14:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€"\ #,##0.00;[Red]\-"€"\ #,##0.00'
      B17:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€"\ #,##0.00;[Red]\-"€"\ #,##0.00'
      B18:
        type: date
        excel_format: dd-mm-yyyy
      B19:
        type: number
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: "0"
      B20:
        type: date
        excel_format: dd-mm-yyyy
      B21:
        type: number
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: "0"
      B26:
        type: date
        excel_format: dd-mm-yyyy
      B28:
        type: number
        notation: scientific
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: "0.00E+00"
      B29:
        type: number
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        useGrouping: true
        excel_format: "#,##0.00;(#,##0.00)"
      B30:
        type: time
        excel_format: hh:mm
      A1:
        style:
          bold: true
      B1:
        style:
          bold: true
      C1:
        style:
          bold: true
      D1:
        style:
          bold: true
      A3:
        style:
          bold: true
      B3:
        style:
          bold: true
---
product,categorie,prijs,aantal,totaal,btw,datum,marge,actief
Appels,fruit,0.45,6,=prijs2*aantal2,=totaal2*btw_tarief,2026-01-05,0.18,true
Brood,bakkerij,2.99,2,=prijs3*aantal3,=totaal3*btw_tarief,2026-01-06,0.32,true
Melk,zuivel,1.19,3,=prijs4*aantal4,=totaal4*btw_tarief,2026-02-01,0.25,false
Kaas,zuivel,8.5,1,=prijs5*aantal5,=totaal5*btw_tarief,2026-02-28,0.41,true
Peren,fruit,0.6,12,=prijs6*aantal6,=totaal6*btw_tarief,2026-03-31,0.2,true
Totaal,,,,=SUM(totaal2:totaal6),=SUM(btw2:btw6),,=AVERAGE(marge2:marge6),
---
id,label,korting
fruit,Fruit,0.1
bakkerij,Bakkerij,0
zuivel,Zuivel,0.05
---
BTW tarief,0.21
---
Overzicht Q1 2026,,,
,,,
Kengetal,Waarde,,
Omzet (SUM over tab),=SUM(producten!totaal2:totaal6),,
"Omzet incl. BTW, afgerond","=ROUND(B4*(1+btw_tarief),2)",,
Korting fruit (VLOOKUP),"=VLOOKUP(""fruit"",cats,3,FALSE)",,
Korting zuivel (XLOOKUP),"=XLOOKUP(""zuivel"",categorieën!id2:id4,categorieën!korting2:korting4,""?"")",,
Label via INDEX/MATCH,"=IFERROR(INDEX(categorieën!$label$2:$label$4,MATCH(""zuivel"",categorieën!$id$2:$id$4,0)),""-"")",,
Aantal fruit (COUNTIF),"=COUNTIF(producten!categorie2:categorie6,""fruit"")",,
Omzet fruit actief (SUMIFS),"=SUMIFS(producten!totaal2:totaal6,producten!categorie2:categorie6,""fruit"",producten!actief2:actief6,TRUE)",,
Gemiddelde prijs,=AVERAGE(producten!prijs2:prijs6),,
SUMPRODUCT prijs x aantal,"=SUMPRODUCT(producten!prijs2:prijs6,producten!aantal2:aantal6)",,
Hele kolom SUM(E:E) min totaal,=SUM(producten!totaal:totaal)-producten!totaal7,,
Absolute ref $C$2*D2,=producten!$prijs$2*producten!aantal2,,
Concat &,"=producten!product2&"" (""&producten!categorie2&"")""",,
TEXTJOIN,"=TEXTJOIN("", "",TRUE,producten!product2:product4)",,
Percent literal 50%*B4,=50%*B4,,
Eerste datum,=MIN(producten!datum2:datum6),,
Dagen tussen eerste en laatste,=MAX(producten!datum2:datum6)-MIN(producten!datum2:datum6),,
Einde maand (EOMONTH),"=EOMONTH(producten!datum2,0)",,
Werkdagen (NETWORKDAYS),"=NETWORKDAYS(producten!datum2,producten!datum6)",,
Datum als tekst (TEXT),"=TEXT(producten!datum2,""dd-mm-yyyy"")",,
IF/AND,"=IF(AND(B4>10,B9<5),""ok"",""check"")",,
Deling door nul,=1/0,,
IFERROR rond deling,"=IFERROR(1/0,""n.v.t."")",,
Vandaag (volatile),=TODAY(),,
Tekst die op een getal lijkt,'007,,
Groot getal,100000000000000000000,,
"Negatief, boekhoudnotatie",-1234.5,,
Tijd,09:30:00,,
Hyperlink,"=HYPERLINK(""https://example.org/"",""WeGotWorkspace"")",,
Rich text,vet en cursief,,
Fout als waarde,=NA(),,
