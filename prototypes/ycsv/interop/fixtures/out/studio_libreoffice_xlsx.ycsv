---
ycsv_version: 1
defs:
  btw_tarief: =instellingen!$B$1
  cats: =categorieën!$id$1:$korting$3
  omzet: =q1_overzicht!$B$4
sheets:
  - ref: producten
    name: Producten
    header: true
    tab_color: "#2e7d32"
    columns:
      - ref: product
        name: Product
        type: string
        width: 154
      - ref: categorie
        name: Categorie
        type: string
        width: 98
      - ref: prijs
        name: Prijs
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[RED]"-€ "#,##0.00'
        width: 84
      - ref: aantal
        name: Aantal
        type: number
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: "0"
        width: 63
      - ref: totaal
        name: Totaal
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[RED]"-€ "#,##0.00'
        width: 98
      - ref: btw
        name: BTW
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[RED]"-€ "#,##0.00'
        width: 84
      - ref: datum
        name: Datum
        type: date
        excel_format: dd\-mm\-yyyy
        width: 84
      - ref: marge
        name: Marge
        type: percent
        minimumFractionDigits: 1
        maximumFractionDigits: 1
        excel_format: 0.0%
        width: 63
      - ref: actief
        name: Actief
        type: boolean
        width: 56
    validate:
      - range: B1:B5
        list: =categorieën!$id$1:$id$3
      - range: D1:D5
        range_value:
          min: 0
          max: 1000
          integer: true
    notes:
      C1: Prijs per stuk, incl. korting
    cells:
      A0:
        style:
          bold: true
          fill: "#f5f5f5"
      B0:
        style:
          bold: true
          fill: "#f5f5f5"
      C0:
        style:
          bold: true
          fill: "#f5f5f5"
      D0:
        style:
          bold: true
          fill: "#f5f5f5"
      E0:
        style:
          bold: true
          fill: "#f5f5f5"
      F0:
        style:
          bold: true
          fill: "#f5f5f5"
      G0:
        style:
          bold: true
          fill: "#f5f5f5"
      H0:
        style:
          bold: true
          fill: "#f5f5f5"
      I0:
        style:
          bold: true
          fill: "#f5f5f5"
      A6:
        style:
          bold: true
      E6:
        style:
          bold: true
      F6:
        style:
          bold: true
      H6:
        style:
          bold: true
  - ref: categorieën
    name: Categorieën
    header: true
    columns:
      - ref: id
        name: Id
        type: string
      - ref: label
        name: Label
        type: string
      - ref: korting
        name: Korting
        type: percent
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: 0%
        width: 63
  - ref: instellingen
    name: Instellingen
    header: false
    hidden: true
    columns:
      - ref: A
        type: string
      - ref: B
        type: percent
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: 0%
  - ref: q1_overzicht
    name: Q1 overzicht
    header: false
    columns:
      - ref: A
        type: string
        width: 238
      - ref: B
        width: 126
      - ref: C
        width: 63
        hidden: true
      - ref: D
    merges:
      - A1:D1
    notes:
      A20: Sheet-level notitie
    cells:
      B4:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[RED]"-€ "#,##0.00'
      B5:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[RED]"-€ "#,##0.00'
      B6:
        type: percent
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: 0%
      B7:
        type: percent
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: 0%
      B9:
        type: number
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: "0"
      B10:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[RED]"-€ "#,##0.00'
      B11:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[RED]"-€ "#,##0.00'
      B12:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[RED]"-€ "#,##0.00'
      B13:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[RED]"-€ "#,##0.00'
      B14:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[RED]"-€ "#,##0.00'
      B17:
        type: currency
        currency: EUR
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: '"€ "#,##0.00;[RED]"-€ "#,##0.00'
      B18:
        type: date
        excel_format: dd\-mm\-yyyy
      B19:
        type: number
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: "0"
      B20:
        type: date
        excel_format: dd\-mm\-yyyy
      B21:
        type: number
        minimumFractionDigits: 0
        maximumFractionDigits: 0
        excel_format: "0"
      B26:
        type: date
        excel_format: dd\-mm\-yyyy
      B28:
        type: number
        notation: scientific
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        excel_format: "0.00E+00"
      B29:
        type: number
        minimumFractionDigits: 2
        maximumFractionDigits: 2
        useGrouping: true
        excel_format: "#,##0.00;\\(#,##0.00\\)"
      B30:
        type: time
        excel_format: hh:mm
      A1:
        style:
          bold: true
      B1:
        style:
          bold: true
      C1:
        style:
          bold: true
      D1:
        style:
          bold: true
      A3:
        style:
          bold: true
      B3:
        style:
          bold: true
      B32:
        style:
          bold: true
---
product,categorie,prijs,aantal,totaal,btw,datum,marge,actief
Appels,fruit,0.45,6,=prijs1*aantal1,=totaal1*btw_tarief,2026-01-05,0.18,true
Brood,bakkerij,2.99,2,=prijs2*aantal2,=totaal2*btw_tarief,2026-01-06,0.32,true
Melk,zuivel,1.19,3,=prijs3*aantal3,=totaal3*btw_tarief,2026-02-01,0.25,false
Kaas,zuivel,8.5,1,=prijs4*aantal4,=totaal4*btw_tarief,2026-02-28,0.41,true
Peren,fruit,0.6,12,=prijs5*aantal5,=totaal5*btw_tarief,2026-03-31,0.2,true
Totaal,,,,=SUM(totaal1:totaal5),=SUM(btw1:btw5),,=AVERAGE(marge1:marge5),
---
id,label,korting
fruit,Fruit,0.1
bakkerij,Bakkerij,0
zuivel,Zuivel,0.05
---
BTW tarief,0.21
---
Overzicht Q1 2026,,,
,,,
Kengetal,Waarde,,
Omzet (SUM over tab),=SUM(producten!totaal1:totaal5),,
"Omzet incl. BTW, afgerond","=ROUND(B4*(1+btw_tarief),2)",,
Korting fruit (VLOOKUP),"=VLOOKUP(""fruit"",cats,3,FALSE)",,
Korting zuivel (XLOOKUP),"=XLOOKUP(""zuivel"",categorieën!id1:id3,categorieën!korting1:korting3,""?"")",,
Label via INDEX/MATCH,"=IFERROR(INDEX(categorieën!$label$1:$label$3,MATCH(""zuivel"",categorieën!$id$1:$id$3,0)),""-"")",,
Aantal fruit (COUNTIF),"=COUNTIF(producten!categorie1:categorie5,""fruit"")",,
Omzet fruit actief (SUMIFS),"=SUMIFS(producten!totaal1:totaal5,producten!categorie1:categorie5,""fruit"",producten!actief1:actief5,TRUE)",,
Gemiddelde prijs,=AVERAGE(producten!prijs1:prijs5),,
SUMPRODUCT prijs x aantal,"=SUMPRODUCT(producten!prijs1:prijs5,producten!aantal1:aantal5)",,
Hele kolom SUM(E:E) min totaal,=SUM(producten!totaal:totaal)-producten!totaal6,,
Absolute ref $C$2*D2,=producten!$prijs$1*producten!aantal1,,
Concat &,"=producten!product1&"" (""&producten!categorie1&"")""",,
TEXTJOIN,"=TEXTJOIN("", "",TRUE,producten!product1:product3)",,
Percent literal 50%*B4,=50%*B4,,
Eerste datum,=MIN(producten!datum1:datum5),,
Dagen tussen eerste en laatste,=MAX(producten!datum1:datum5)-MIN(producten!datum1:datum5),,
Einde maand (EOMONTH),"=EOMONTH(producten!datum1,0)",,
Werkdagen (NETWORKDAYS),"=NETWORKDAYS(producten!datum1,producten!datum5)",,
Datum als tekst (TEXT),"=TEXT(producten!datum1,""dd-mm-yyyy"")",,
IF/AND,"=IF(AND(B4>10,B9<5),""ok"",""check"")",,
Deling door nul,=1/0,,
IFERROR rond deling,"=IFERROR(1/0,""n.v.t."")",,
Vandaag (volatile),=TODAY(),,
Tekst die op een getal lijkt,'007,,
Groot getal,100000000000000000000,,
"Negatief, boekhoudnotatie",-1234.5,,
Tijd,09:30:00,,
Hyperlink,"=HYPERLINK(""https://example.org/"",""WeGotWorkspace"")",,
Rich text,vet en cursief,,
Fout als waarde,=NA(),,
