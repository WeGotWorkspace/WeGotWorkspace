{
  "extends": "stylelint-config-standard",
  "rules": {
    "color-no-hex": true
  },
  "overrides": [
    {
      "files": [
        "src/styles.css",
        "src/foundations/**/*.css",
        "src/**/*token*.css",
        "src/**/*color*.css"
