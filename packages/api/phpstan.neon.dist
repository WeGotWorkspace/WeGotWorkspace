# PHPStan level 8 (Larastan) for packages/api.
#
# The committed baseline (phpstan-baseline.neon) may only shrink.
# scripts/phpstan-baseline-shrink.php fails the done gate when the sum of
# `count:` is higher than on origin/main. Do not regenerate the file to
# clear new findings. CI also fails on any finding that is not already in
# the baseline. When a finding is fixed, delete its baseline entry in that
# pull request (remove the entry, or lower its count).
#
# tests/ is intentionally outside `paths`. Tables created through
# $this->wgw() in database/migrations/wgw are invisible to Larastan.
# Declare each column with @property (see App\Models\User and
# packages/api/docs/sql-schema.md).
includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 8
    # Sabre component fields are typed in stubs/phpstan/V*.stub.php.
    # Hyphenated names stay on vendor __get(): Property|null.
    stubFiles:
        - stubs/phpstan/SabreVObject.php
        - stubs/phpstan/SabreVObjectTypes.stub.php
        - stubs/phpstan/SabreITipBroker.php
        - stubs/phpstan/PassportClient.php
        - stubs/phpstan/VCalendar.stub.php
        - stubs/phpstan/VEvent.stub.php
        - stubs/phpstan/VTodo.stub.php
        - stubs/phpstan/VJournal.stub.php
        - stubs/phpstan/VAlarm.stub.php
        - stubs/phpstan/VCard.stub.php
    paths:
        - app
        - bootstrap
        - config
        - database
        - routes
        - scripts
    excludePaths:
        - bootstrap/cache/*
    reportUnmatchedIgnoredErrors: true
