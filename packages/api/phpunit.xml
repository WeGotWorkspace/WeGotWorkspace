<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <directory>tests/Database</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Storage">
            <directory>tests/Storage</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Full suite accumulates past low CLI defaults (128M) before the late storage-heavy tests. -->
        <ini name="memory_limit" value="512M"/>
        <!-- Fixed key for PHPUnit/CI only (packages/api/.env is gitignored). -->
        <env name="APP_KEY" value="base64:v0owzbW5YBuFZHa31dE5LlOg4wruLmtLj/VBX2yAbKk="/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="wgw"/>
        <env name="WGW_DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- Dev-only JWT paths in .env.example must not override installer test keys. -->
        <env name="WGW_API_JWT_PRIVATE_KEY_PATH" value=""/>
        <env name="WGW_API_JWT_PUBLIC_KEY_PATH" value=""/>
    </php>
</phpunit>
