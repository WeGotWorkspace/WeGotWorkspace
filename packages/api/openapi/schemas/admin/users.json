{
  "AdminUserUpdateRequest": {
    "type": "object",
    "properties": {
      "displayName": {
        "type": "string"
      },
      "email": {
        "type": "string"
      },
      "password": {
        "type": "string"
      },
      "groups": {
        "$ref": "#/components/schemas/AdminUserGroupList"
      },
      "enabled": {
        "type": "boolean"
      },
      "isAdmin": {
        "type": "boolean",
        "description": "Grant or remove the admin role. Changing it signs the user out everywhere. An admin cannot remove their own role, and the last admin cannot lose it."
      }
    },
    "example": {
      "displayName": "Alice Cooper",
      "email": "alice@example.test",
      "groups": [
        "principals/groups/support"
      ],
      "enabled": true
    }
  },
  "AdminUserSummary": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "username": {
        "type": "string"
      },
      "email": {
        "type": "string"
      },
      "displayName": {
        "type": "string"
      },
      "groups": {
        "$ref": "#/components/schemas/AdminUserGroupList"
      },
      "createdAt": {
        "type": "string"
      },
      "enabled": {
        "type": "boolean"
      },
      "isAdmin": {
        "type": "boolean",
        "description": "Whether the user has the admin role."
      }
    },
    "required": [
      "id",
      "username",
      "email",
      "displayName",
      "groups",
      "createdAt",
      "enabled",
      "isAdmin"
    ]
  }
}
