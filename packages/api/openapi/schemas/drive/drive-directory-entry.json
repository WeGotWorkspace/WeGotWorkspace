{
  "DriveDirectoryEntry": {
    "type": "object",
    "properties": {
      "type": {
        "$ref": "#/components/schemas/DriveEntryType"
      },
      "path": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "size": {
        "type": "integer"
      },
      "time": {
        "type": "integer"
      },
      "permissions": {
        "type": "integer"
      },
      "myRights": {
        "$ref": "#/components/schemas/DriveRights"
      },
      "hasShares": {
        "type": "boolean",
        "description": "True when this path has direct outgoing share grants (member, guest, or public)."
      },
      "hasPublicShare": {
        "type": "boolean",
        "description": "True when this path has an active public link share."
      },
      "hasTeamShare": {
        "type": "boolean",
        "description": "True when this path has active team grants (users or groups) on a member share."
      }
    },
    "required": [
      "type",
      "path",
      "name",
      "size",
      "time",
      "permissions",
      "myRights"
    ]
  }
}
