{
  "RtcNetClass": {
    "type": "string",
    "enum": ["open", "symmetric", "udp-blocked", "unknown"],
    "description": "Network class the peer measured for itself before joining."
  },
  "RtcPeerCapability": {
    "type": "string",
    "enum": [
      "bin",
      "ice-batch",
      "ticket",
      "meet-dc",
      "yjs-http",
      "relay-jit",
      "since-ack"
    ],
    "description": "Wire capability a peer advertises at join. Stored on the peer row and mirrored on rosters."
  },
  "RtcPeerAccess": {
    "type": "string",
    "enum": ["read", "comment", "write"],
    "description": "Collaboration rights computed by the server at join from the drive share rights. Fail-closed: a peer row without a server-written value reads as `read`."
  },
  "RtcRosterPeer": {
    "type": "object",
    "required": ["id", "name"],
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "user": {
        "type": "string",
        "description": "Username of the owning account. Collaboration and principal rosters always carry it; meeting rosters only when the polling actor is authenticated, so guests never see member usernames."
      },
      "access": {
        "$ref": "#/components/schemas/RtcPeerAccess"
      },
      "caps": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RtcPeerCapability"
        }
      },
      "net": {
        "$ref": "#/components/schemas/RtcNetClass"
      }
    }
  },
  "RtcRoomLimits": {
    "type": "object",
    "description": "Server-side ceilings for the room, advertised on the meeting join response.",
    "required": ["maxPeers", "maxVideoProfile", "maxVideoProfileRelay"],
    "properties": {
      "maxPeers": {
        "type": "integer",
        "description": "Peers allowed in the room (`MEET_MAX_PEERS`, default 4, clamped 2-15)."
      },
      "maxVideoProfile": {
        "type": "string",
        "enum": ["p720", "p360", "p270", "p180", "audio"],
        "description": "Highest camera profile Meet may select. Clients still pick the profile automatically."
      },
      "maxVideoProfileRelay": {
        "type": "string",
        "enum": ["p720", "p360", "p270", "p180", "audio"],
        "description": "Highest camera profile a sender may use while its selected candidate pair is relayed. Clamped to maxVideoProfile."
      }
    }
  },
  "RtcTurnCredentials": {
    "type": "object",
    "required": ["urls", "username", "credential", "ttl"],
    "description": "Short-lived relay credentials in the TURN REST convention (coturn `use-auth-secret`). Issued only by the relay request, never at join and never by the room configuration endpoint.",
    "properties": {
      "urls": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "username": {
        "type": "string",
        "description": "`<unixExpiry>:<first 16 hex of sha1(actor marker)>`."
      },
      "credential": {
        "type": "string",
        "description": "`base64(HMAC-SHA1(turnSecret, username))`."
      },
      "ttl": {
        "type": "integer",
        "description": "Lifetime in seconds."
      }
    }
  },
  "RtcRoomConfiguration": {
    "type": "object",
    "required": ["rtc"],
    "properties": {
      "rtc": {
        "type": "object",
        "required": ["stunUrls", "turnAvailable"],
        "properties": {
          "stunUrls": {
            "type": "string",
            "description": "Comma-separated STUN URLs."
          },
          "turnAvailable": {
            "type": "boolean",
            "description": "True when a relay secret is configured. Credentials are never part of this response."
          }
        }
      },
      "collabTicket": {
        "type": "object",
        "required": ["kid", "jwk"],
        "description": "Public half of the contract C2 ticket signing key. No private material is ever part of this response.",
        "properties": {
          "kid": { "type": "string", "description": "Key id the ticket header names." },
          "jwk": {
            "type": "object",
            "required": ["kty", "crv", "x", "y", "kid"],
            "properties": {
              "kty": { "type": "string", "enum": ["EC"] },
              "crv": { "type": "string", "enum": ["P-256"] },
              "x": { "type": "string", "description": "base64url, 32 bytes." },
              "y": { "type": "string", "description": "base64url, 32 bytes." },
              "kid": { "type": "string" },
              "alg": { "type": "string", "enum": ["ES256"] },
              "use": { "type": "string", "enum": ["sig"] }
            }
          }
        }
      }
    }
  },
  "RtcJoinRequest": {
    "type": "object",
    "properties": {
      "peerId": {
        "type": "string",
        "description": "Client-chosen peer id (meeting rooms). Collaboration and principal rooms get one from the server."
      },
      "name": {
        "type": "string"
      },
      "net": {
        "$ref": "#/components/schemas/RtcNetClass"
      },
      "caps": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RtcPeerCapability"
        }
      },
      "browserId": {
        "type": "string",
        "description": "Opaque per-browser-profile token used to evict leftover peers from the same browser."
      },
      "sessionKey": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$",
        "description": "Server-issued guest session key from an earlier join. 64 hex characters: 16 random bytes plus the leading HMAC-SHA256 under APP_KEY. A caller-chosen key is ignored."
      }
    }
  },
  "RtcJoinResponse": {
    "type": "object",
    "required": ["peers"],
    "properties": {
      "peerId": {
        "type": "string",
        "description": "Server-assigned peer id (collaboration and principal rooms)."
      },
      "peers": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RtcRosterPeer"
        }
      },
      "sessionKey": {
        "type": "string",
        "nullable": true,
        "pattern": "^[a-f0-9]{64}$",
        "description": "Server-issued guest session key for meeting rooms. 64 hex characters: 16 random bytes plus the leading HMAC-SHA256 under APP_KEY. Null for an authenticated member."
      },
      "ticket": {
        "type": "string",
        "description": "Signed collaboration ticket a peer presents to the other peers in the mesh."
      },
      "rtc": {
        "type": "object",
        "properties": {
          "limits": {
            "$ref": "#/components/schemas/RtcRoomLimits"
          }
        }
      }
    }
  },
  "RtcMailboxMessage": {
    "type": "object",
    "required": ["from", "type"],
    "properties": {
      "id": {
        "type": "integer",
        "description": "Monotonic mailbox id. Present on channels that poll with a `since` cursor."
      },
      "from": {
        "type": "string"
      },
      "to": {
        "type": "string"
      },
      "type": {
        "type": "string",
        "enum": [
          "offer",
          "answer",
          "ice",
          "bye",
          "chat",
          "yjs",
          "yjs-sv",
          "relay-hint"
        ],
        "description": "`relay-hint` is server-inserted only: a client that sends it is answered with `bad_type`."
      },
      "payload": {}
    }
  },
  "RtcPollResponse": {
    "type": "object",
    "required": ["peers", "messages", "rosterSig"],
    "properties": {
      "peers": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RtcRosterPeer"
        }
      },
      "messages": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/RtcMailboxMessage"
        }
      },
      "rosterSig": {
        "type": "string",
        "description": "Roster signature to echo as `?sig=` on the next poll."
      },
      "ticket": {
        "type": "string",
        "description": "Signed collaboration ticket, refreshed on every poll."
      }
    }
  },
  "RtcSendEventResponse": {
    "description": "The send was queued. The same object carries the sender's pending mailbox so the client can apply it without waiting for the next poll.",
    "allOf": [
      { "$ref": "#/components/schemas/OkResponse" },
      { "$ref": "#/components/schemas/RtcPollResponse" }
    ]
  },
  "RtcSendEventRequest": {
    "type": "object",
    "required": ["to", "type"],
    "properties": {
      "peerId": {
        "type": "string",
        "description": "Sending peer on collaboration and principal rooms."
      },
      "from": {
        "type": "string",
        "description": "Sending peer on meeting rooms."
      },
      "to": {
        "type": "string"
      },
      "type": {
        "type": "string",
        "enum": ["offer", "answer", "ice", "bye", "yjs", "yjs-sv"]
      },
      "payload": {}
    }
  },
  "RtcRelayRequest": {
    "type": "object",
    "required": ["peerId", "target", "reason"],
    "properties": {
      "peerId": {
        "type": "string",
        "description": "Peer id owned by the calling actor."
      },
      "target": {
        "type": "string",
        "description": "Peer id in the room roster, or `*` when the reason is `precheck`."
      },
      "reason": {
        "type": "string",
        "enum": ["precheck", "timeout", "failed"]
      },
      "net": {
        "$ref": "#/components/schemas/RtcNetClass"
      }
    }
  },
  "RtcRelayResponse": {
    "type": "object",
    "required": ["turn"],
    "properties": {
      "turn": {
        "$ref": "#/components/schemas/RtcTurnCredentials"
      }
    }
  },
  "RtcSessionMetricReport": {
    "type": "object",
    "required": ["channel"],
    "description": "One session sample for the real-time health page. Fields map to `rtc_session_metrics`; the row carries no addresses, room names, or user ids.",
    "properties": {
      "channel": {
        "type": "string",
        "enum": ["meet", "collab"]
      },
      "joinMs": {
        "type": "integer",
        "description": "Milliseconds from join to the first connected peer (`join_ms`)."
      },
      "candidateType": {
        "type": "string",
        "enum": ["host", "srflx", "prflx", "relay"],
        "description": "Winning candidate type (`candidate_type`)."
      },
      "failedPairs": {
        "type": "integer",
        "description": "Candidate pairs that never connected (`failed_pairs`)."
      },
      "iceRestarts": {
        "type": "integer",
        "description": "ICE restarts during the session (`ice_restarts`)."
      },
      "httpFallback": {
        "type": "boolean",
        "description": "Session fell back to HTTP transport (`http_fallback`)."
      },
      "pollRttMs": {
        "type": "integer",
        "description": "Median signaling poll round trip (`poll_rtt_ms`)."
      },
      "net": {
        "$ref": "#/components/schemas/RtcNetClass"
      }
    }
  },
  "RtcRealtimeHealthWindow": {
    "type": "object",
    "required": [
      "samples",
      "joinP50Ms",
      "joinP95Ms",
      "relayPercent",
      "failedPairsPercent",
      "fallbackPercent",
      "pollP95Ms",
      "constrainedPercent",
      "byChannel"
    ],
    "properties": {
      "samples": { "type": "integer" },
      "joinP50Ms": { "type": ["integer", "null"] },
      "joinP95Ms": { "type": ["integer", "null"] },
      "relayPercent": { "type": "number" },
      "failedPairsPercent": { "type": "number" },
      "fallbackPercent": { "type": "number" },
      "pollP95Ms": { "type": ["integer", "null"] },
      "constrainedPercent": {
        "type": "number",
        "description": "Share of samples whose net class is symmetric or udp-blocked."
      },
      "byChannel": {
        "type": "object",
        "required": ["meet", "collab"],
        "properties": {
          "meet": { "type": "integer" },
          "collab": {
            "type": "integer",
            "description": "Docs sessions. The wire name stays collab."
          }
        }
      }
    }
  },
  "RtcRealtimeHealthDay": {
    "type": "object",
    "required": ["date", "issued", "unavailable", "denied"],
    "properties": {
      "date": { "type": "string" },
      "issued": { "type": "integer" },
      "unavailable": { "type": "integer" },
      "denied": { "type": "integer" }
    }
  },
  "RtcRealtimeHealth": {
    "type": "object",
    "required": [
      "day",
      "week",
      "relayDays",
      "turnConfigured",
      "unavailablePeopleThisWeek",
      "callout",
      "retentionDays"
    ],
    "properties": {
      "day": { "$ref": "#/components/schemas/RtcRealtimeHealthWindow" },
      "week": { "$ref": "#/components/schemas/RtcRealtimeHealthWindow" },
      "relayDays": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/RtcRealtimeHealthDay" }
      },
      "turnConfigured": { "type": "boolean" },
      "unavailablePeopleThisWeek": { "type": "integer" },
      "callout": {
        "type": ["string", "null"],
        "description": "Set when TURN is not configured and someone could not connect directly this week."
      },
      "retentionDays": { "type": "integer" }
    }
  }
}
