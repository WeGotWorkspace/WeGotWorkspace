{
  "MeetRoomCode": {
    "type": "string",
    "minLength": 4,
    "maxLength": 64,
    "pattern": "^[A-Za-z0-9_-]{4,64}$",
    "description": "Meet room id. Calendar and ad-hoc Start use xxxx-xxxx-xxxx (createMeetRoomCode)."
  },
  "MeetOwnerPrincipal": {
    "type": "string",
    "pattern": "^(?:u:[A-Za-z0-9._-]+|groups/[a-z0-9_-]+)$",
    "description": "Personal calendar or ad-hoc start: u:{username}. Group calendar: groups/{slug}."
  },
  "MeetReserveRoomRequest": {
    "type": "object",
    "required": ["room", "ownerPrincipal"],
    "additionalProperties": false,
    "properties": {
      "room": { "$ref": "#/components/schemas/MeetRoomCode" },
      "ownerPrincipal": { "$ref": "#/components/schemas/MeetOwnerPrincipal" },
      "expiresAt": {
        "type": ["string", "null"],
        "format": "date-time",
        "description": "Omit or null for no inactivity expiry (series master / this-and-future)."
      }
    }
  },
  "MeetPatchRoomRequest": {
    "type": "object",
    "required": ["expiresAt"],
    "additionalProperties": false,
    "properties": {
      "expiresAt": {
        "type": ["string", "null"],
        "format": "date-time"
      }
    }
  },
  "MeetRoomGuestStatus": {
    "type": "object",
    "required": ["reserved", "active"],
    "additionalProperties": false,
    "properties": {
      "reserved": { "type": "boolean", "const": true },
      "active": { "type": "boolean" }
    },
    "description": "Public/guest GET body. No ownerPrincipal, createdBy, or expiresAt."
  },
  "MeetRoomOwnerStatus": {
    "type": "object",
    "required": ["reserved", "active", "ownerPrincipal", "createdBy", "expiresAt"],
    "additionalProperties": false,
    "properties": {
      "reserved": { "type": "boolean", "const": true },
      "active": { "type": "boolean" },
      "ownerPrincipal": { "$ref": "#/components/schemas/MeetOwnerPrincipal" },
      "createdBy": { "$ref": "#/components/schemas/MeetOwnerPrincipal" },
      "expiresAt": {
        "type": ["string", "null"],
        "format": "date-time"
      }
    }
  },
  "MeetReserveRoomResponse": {
    "allOf": [
      { "$ref": "#/components/schemas/MeetRoomOwnerStatus" },
      {
        "type": "object",
        "required": ["roomId"],
        "properties": {
          "roomId": { "$ref": "#/components/schemas/MeetRoomCode" }
        }
      }
    ]
  }
}
