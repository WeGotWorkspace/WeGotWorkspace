{
  "CalendarRights": {
    "type": "object",
    "required": ["mayRead", "mayWrite", "mayShare", "mayDelete"],
    "properties": {
      "mayRead": { "type": "boolean" },
      "mayWrite": { "type": "boolean" },
      "mayShare": { "type": "boolean", "description": "May modify shareWith. True for personal calendar owners." },
      "mayDelete": { "type": "boolean" }
    },
    "additionalProperties": false,
    "description": "JMAP CalendarRights."
  },
  "Calendar": {
    "type": "object",
    "required": ["id", "name", "sortOrder", "isDefault", "isSubscribed", "scope", "groupSlug", "myRights"],
    "properties": {
      "id": {
        "$ref": "#/components/schemas/JmapId",
        "readOnly": true
      },
      "name": { "type": "string", "minLength": 1, "maxLength": 255 },
      "description": { "type": ["string", "null"] },
      "timeZone": { "type": ["string", "null"] },
      "color": { "type": ["string", "null"] },
      "sortOrder": { "type": "integer", "minimum": 0 },
      "isDefault": { "type": "boolean" },
      "isSubscribed": {
        "type": "boolean",
        "description": "JMAP Calendar visibility (whether the calendar is shown). Not a remote ICS/webcal subscription marker."
      },
      "subscriptionId": {
        "type": ["string", "null"],
        "description": "Owner-visible id of the live ICS/webcal subscription backing this collection; null for ordinary calendars. Distinct from isSubscribed."
      },
      "scope": {
        "type": "string",
        "enum": ["personal", "group"],
        "description": "Storage scope: personal (principals/{username}) or group (principals/groups/{slug})."
      },
      "groupSlug": {
        "type": ["string", "null"],
        "description": "Group slug when scope is group; null for personal calendars."
      },
      "shareWith": {
        "description": "Owner map of JMAP id (username or groups/{slug}) to CalendarRights. Null when the calendar is not shared or the caller is not the owner. Recipients always see null.",
        "oneOf": [
          {
            "type": "object",
            "propertyNames": { "$ref": "#/components/schemas/JmapId" },
            "additionalProperties": { "$ref": "#/components/schemas/CalendarRights" }
          },
          { "type": "null" }
        ]
      },
      "myRights": { "$ref": "#/components/schemas/CalendarRights" }
    },
    "additionalProperties": false,
    "description": "JMAP Calendar resource.",
    "example": {
      "id": "default",
      "name": "Calendar",
      "description": null,
      "timeZone": null,
      "color": null,
      "sortOrder": 0,
      "isDefault": true,
      "isSubscribed": true,
      "subscriptionId": null,
      "scope": "personal",
      "groupSlug": null,
      "shareWith": null,
      "myRights": {
        "mayRead": true,
        "mayWrite": true,
        "mayShare": true,
        "mayDelete": false
      }
    }
  },
  "CalendarListResponse": {
    "type": "object",
    "required": ["list"],
    "properties": {
      "list": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/Calendar" }
      }
    },
    "additionalProperties": false,
    "description": "REST list response for GET /calendars."
  }
}
