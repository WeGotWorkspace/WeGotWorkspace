{
  "Note": {
    "type": "object",
    "required": ["id", "notebookId", "title", "body", "categories", "status", "etag"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "description": "VJOURNAL UID"
      },
      "notebookId": {
        "type": "string"
      },
      "title": {
        "type": ["string", "null"]
      },
      "body": {
        "type": "string"
      },
      "categories": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "status": {
        "type": ["string", "null"],
        "enum": ["FINAL", "CANCELLED", null]
      },
      "etag": {
        "type": "string"
      },
      "starred": {
        "type": "boolean"
      }
    }
  },
  "NoteListResponse": {
    "type": "object",
    "required": ["list"],
    "additionalProperties": false,
    "properties": {
      "list": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Note"
        }
      }
    }
  },
  "NoteCreate": {
    "type": "object",
    "required": ["notebookId"],
    "additionalProperties": false,
    "properties": {
      "notebookId": {
        "type": "string"
      },
      "title": {
        "type": ["string", "null"]
      },
      "body": {
        "type": "string"
      },
      "categories": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "status": {
        "type": ["string", "null"],
        "enum": ["FINAL", "CANCELLED", null]
      },
      "uid": {
        "type": "string"
      }
    }
  },
  "NotePatch": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "notebookId": {
        "type": "string"
      },
      "title": {
        "type": ["string", "null"]
      },
      "body": {
        "type": "string"
      },
      "categories": {
        "description": "Replace the whole tag set. Create uses this, and so does an explicit replace. Tag edits use categoriesAdd and categoriesRemove. Archive, star, and notebook move omit this field. Do not combine this field with either delta field.",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "categoriesAdd": {
        "description": "Tags to add onto the set stored in the journal. Applied after categoriesRemove, on the locked row. A new tag uses the same rule as categories. Do not send with categories.",
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 255
        }
      },
      "categoriesRemove": {
        "description": "Tags to remove from the set stored in the journal, before categoriesAdd. An invalid or stale tag is allowed so it can always be removed. Do not send with categories.",
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 255
        }
      },
      "status": {
        "type": ["string", "null"],
        "enum": ["FINAL", "CANCELLED", null]
      }
    }
  },
  "NoteCollaborativePut": {
    "type": "object",
    "additionalProperties": false,
    "required": ["markdown", "yjs"],
    "properties": {
      "markdown": {
        "type": "string",
        "description": "DESCRIPTION projection of the Yjs document."
      },
      "title": {
        "type": "string",
        "description": "SUMMARY projection. Omit it when the document has not adopted a title, so a body save does not clear SUMMARY."
      },
      "yjs": {
        "type": "array",
        "description": "Full Yjs document state as a list of bytes (0-255). Rejected with 413 above 5 MiB.",
        "maxItems": 5242880,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      },
      "room": {
        "type": "string",
        "description": "Room id the shared save includes. The note is addressed by the path, so this field is ignored."
      }
    }
  }
}
