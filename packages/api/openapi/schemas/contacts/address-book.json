{
  "AddressBookRights": {
    "type": "object",
    "required": ["mayRead", "mayWrite", "mayShare", "mayDelete"],
    "properties": {
      "mayRead": {
        "type": "boolean",
        "description": "May fetch cards in this address book."
      },
      "mayWrite": {
        "type": "boolean",
        "description": "May create, update, delete, or move cards."
      },
      "mayShare": {
        "type": "boolean",
        "description": "May modify shareWith. True for personal owners and current members of a group-owned book. False on inbound sharees."
      },
      "mayDelete": {
        "type": "boolean",
        "description": "False on owned and membership books. True on inbound sharees means dismiss/hide (addressbook_share_dismissals), not delete the owner's book."
      }
    },
    "additionalProperties": false,
    "description": "RFC 9610 AddressBookRights."
  },
  "AddressBook": {
    "type": "object",
    "required": ["id", "name", "sortOrder", "isDefault", "isSubscribed", "isSharee", "myRights"],
    "properties": {
      "id": {
        "$ref": "#/components/schemas/JsContactId",
        "description": "Immutable server-set identifier. Personal book is `default`; group membership books are `group-{slug}`; inbound shares are `shared-{addressbookId}`."
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "description": "Server-set from the principal display name. Name patches are forbidden."
      },
      "description": {
        "type": ["string", "null"],
        "description": "Long-form description; null when unset."
      },
      "sortOrder": {
        "$ref": "#/components/schemas/JsContactUnsignedInt",
        "description": "UI sort order; lower values appear first."
      },
      "isDefault": {
        "type": "boolean",
        "description": "Server-set default address book flag."
      },
      "isSubscribed": {
        "type": "boolean",
        "description": "Whether the book is shown in client UI."
      },
      "shareWith": {
        "oneOf": [
          {
            "type": "object",
            "propertyNames": {
              "$ref": "#/components/schemas/JsContactId"
            },
            "additionalProperties": {
              "$ref": "#/components/schemas/AddressBookRights"
            }
          },
          { "type": "null" }
        ],
        "description": "Persisted grants. Principal ids are `username` or `groups/{slug}`. Recipients see null. mayWrite (or mayWriteAll) → edit; otherwise view. Null grant revokes."
      },
      "isSharee": {
        "type": "boolean",
        "description": "True on inbound share listings (Shared with me). False for personal owners and group-membership books."
      },
      "myRights": {
        "$ref": "#/components/schemas/AddressBookRights",
        "description": "Current user's access rights for this book."
      }
    },
    "additionalProperties": false,
    "description": "RFC 9610 AddressBook.",
    "example": {
      "id": "default",
      "name": "Default Address Book",
      "description": null,
      "sortOrder": 0,
      "isDefault": true,
      "isSubscribed": true,
      "isSharee": false,
      "shareWith": null,
      "myRights": {
        "mayRead": true,
        "mayWrite": true,
        "mayShare": true,
        "mayDelete": false
      }
    }
  },
  "ContactAddressBookListResponse": {
    "type": "object",
    "required": ["list"],
    "properties": {
      "list": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/AddressBook"
        }
      }
    },
    "additionalProperties": false,
    "description": "REST list response for GET /contacts/addressbooks.",
    "example": {
      "list": [
        {
          "id": "default",
          "name": "Default Address Book",
          "description": null,
          "sortOrder": 0,
          "isDefault": true,
          "isSubscribed": true,
          "isSharee": false,
          "shareWith": null,
          "myRights": {
            "mayRead": true,
            "mayWrite": true,
            "mayShare": true,
            "mayDelete": false
          }
        }
      ]
    }
  }
}
