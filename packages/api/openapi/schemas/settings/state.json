{
  "SettingsUserGroup": {
    "type": "object",
    "description": "A Team the caller belongs to.",
    "properties": {
      "id": {
        "type": "string",
        "description": "Group principal uri (principals/groups/\u2026)."
      },
      "displayName": {
        "type": "string"
      },
      "memberCount": {
        "type": "integer",
        "minimum": 0,
        "description": "How many members the Team has, the caller included."
      }
    },
    "required": [
      "id",
      "displayName",
      "memberCount"
    ]
  },
  "SettingsUserGroupList": {
    "type": "array",
    "items": {
      "$ref": "#/components/schemas/SettingsUserGroup"
    }
  },
  "SettingsStateResponse": {
    "type": "object",
    "properties": {
      "user": {
        "$ref": "#/components/schemas/SettingsUserProfile"
      },
      "groups": {
        "$ref": "#/components/schemas/SettingsUserGroupList"
      },
      "isAdmin": {
        "type": "boolean",
        "description": "Whether the caller has the admin role. Admin is a role per user, not membership of a Team."
      },
      "logoutUrl": {
        "type": "string"
      },
      "mcpEnabled": {
        "type": "boolean",
        "description": "Whether AI assistants (MCP) is enabled for this instance. Readable by any signed-in user so Settings can hide the pane without calling Admin APIs."
      }
    },
    "required": [
      "user",
      "groups",
      "isAdmin",
      "logoutUrl",
      "mcpEnabled"
    ]
  }
}
