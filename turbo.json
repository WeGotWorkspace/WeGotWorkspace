{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "generated/**"]
    },
    "typegen": {
      "dependsOn": ["^typegen"],
      "outputs": ["generated/**"],
      "inputs": [
        "$TURBO_ROOT$/packages/api/openapi/openapi.json",
        "$TURBO_ROOT$/packages/api/openapi/schemas/**",
        "scripts/**",
        "package.json"
      ]
    },
    "typegen:check": {
      "dependsOn": ["typegen"],
      "cache": false
    },
    "typegen:watch": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "env": ["CI"]
    },
    "format:check": {
      "outputs": [],
      "env": ["CI"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["CI"]
    },
    "test:unit": {
      "outputs": [],
      "env": ["CI"]
    },
    "test:jsdom": {
      "outputs": [],
      "env": ["CI", "JSDOM_CONCURRENCY", "JSDOM_SOLO_CONCURRENCY"]
    },
    "test:contract": {
      "dependsOn": ["@wgw/openapi-types#typegen"],
      "outputs": [],
      "env": ["CI"]
    },
    "test:storybook": {
      "outputs": [],
      "env": ["CI", "STORYBOOK_A11Y_GATE", "STORYBOOK_VITEST_SMOKE"]
    },
    "test:storybook:ci": {
      "outputs": [],
      "env": ["CI", "STORYBOOK_A11Y_GATE", "STORYBOOK_VITEST_SMOKE"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["VITE_*", "WGW_*"]
    },
    "dev:app": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["VITE_*", "WGW_*"]
    },
    "dev:storybook": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["VITE_*", "WGW_*"]
    },
    "preview": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["VITE_*", "WGW_*"]
    }
  }
}
