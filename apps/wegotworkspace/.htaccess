Options -Indexes -MultiViews

# Deny private trees and known sensitive dotfiles even when mod_rewrite is off.
# mod_alias is effectively always present. Other "/." segments stay reachable
# so WebDAV can serve .attachments, .notes, .Trash, and AppleDouble files.
RedirectMatch 404 ^/(?:wgw-content|wgw-private|wgw-modules|packages)(?:/|$)
RedirectMatch 404 /\.(?:git|svn|hg|env|htaccess|htpasswd|user\.ini)(?:[/.]|$)

# Conservative shared-host upload cap (PHP default is 8M). Ignored on PHP-FPM;
# see .user.ini. Must stay in sync with docker/php/uploads.ini.
<IfModule mod_php.c>
    php_value post_max_size 32M
    php_value upload_max_filesize 32M
    php_value display_errors 0
</IfModule>
<IfModule mod_php8.c>
    php_value post_max_size 32M
    php_value upload_max_filesize 32M
    php_value display_errors 0
</IfModule>

# PWA ships index.html beside index.php for Workbox precache; always route "/" through Laravel
# so unconfigured installs redirect to /install/ (see UiStaticFront).
<IfModule mod_dir.c>
    DirectoryIndex index.php
</IfModule>

# WebAssembly assets: ensure correct Content-Type when host mime.types omits .wasm.
<IfModule mod_mime.c>
    AddType application/wasm .wasm
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # RFC 6764 — CalDAV/CardDAV service discovery.
    # Empty substitution is relative, so RewriteBase (including a subfolder) is the target.
    RewriteRule ^\.well-known/caldav$ "" [R=301,L]
    RewriteRule ^\.well-known/carddav$ "" [R=301,L]

    # Origin-root MCP OAuth discovery (/.well-known/oauth-*) falls through to
    # index.php with other unknown paths. Do not require /api for those URLs.

    # Never expose runtime internals, config, or source trees directly.
    RewriteRule ^(?:wgw-modules|wgw-private|wgw-content)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:wgw-src|src|resources|vendor|scripts|patches|config|public|packages)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:composer\.(?:json|lock)|package\.json|wgw-config(?:\.sample)?\.php|\.env)$ - [F,L,NC]

    # Copy Authorization into the env var Sabre's stack reads.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [L]
</IfModule>
