Options -Indexes -MultiViews

# Deny private trees and known sensitive dotfiles even when mod_rewrite is off.
# mod_alias is effectively always present. Other "/." segments stay reachable
# so WebDAV can serve .attachments, .notes, .Trash, and AppleDouble files.
RedirectMatch 404 ^/(?:wgw-content|wgw-private|wgw-modules|packages)(?:/|$)
RedirectMatch 404 /\.(?:git|svn|hg|env|htaccess|htpasswd|user\.ini)(?:[/.]|$)

# Conservative shared-host upload cap (PHP default is 8M). Ignored on PHP-FPM;
# see .user.ini. Must stay in sync with docker/php/uploads.ini.
<IfModule mod_php.c>
    php_value post_max_size 32M
    php_value upload_max_filesize 32M
    php_value display_errors 0
</IfModule>
<IfModule mod_php8.c>
    php_value post_max_size 32M
    php_value upload_max_filesize 32M
    php_value display_errors 0
</IfModule>

# PWA ships index.html beside index.php for Workbox precache; always route "/" through Laravel
# so unconfigured installs redirect to /install/ (see UiStaticFront).
<IfModule mod_dir.c>
    DirectoryIndex index.php
</IfModule>

# WebAssembly assets: ensure correct Content-Type when host mime.types omits .wasm.
# script-src includes 'wasm-unsafe-eval' because plugin bundles compile these
# files in the page. Chromium blocks WebAssembly.compile/instantiate without it.
<IfModule mod_mime.c>
    AddType application/wasm .wasm
</IfModule>

# Apache serves /index.html, /sw.js, /assets/*, and fonts without PHP, so HSTS
# for those files has to be set here. Middleware still sets HSTS when mod_headers
# is off. env=HTTPS is mod_ssl, when Apache itself terminates TLS. Behind a proxy
# that sends X-Forwarded-Proto, WGW_HTTPS covers the same header. Do not copy that
# proto into the HTTPS variable: PHP Request::isSecure() reads it and would ignore
# trustProxies. Browsers ignore HSTS on plain HTTP, so a spoofed proto does not stick.
# The served shell has no inline script, so the policy has no script hash.
# Report-only until enforcement.
<IfModule mod_headers.c>
    <IfModule mod_setenvif.c>
        SetEnvIf X-Forwarded-Proto "^https$" WGW_HTTPS=on
    </IfModule>
    Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
    Header always set Strict-Transport-Security "max-age=15552000" env=WGW_HTTPS
    <Files "index.html">
        Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; font-src 'self'; connect-src 'self'; media-src 'self' blob:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; report-uri /api/v1/csp-reports"
    </Files>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # RFC 6764 — CalDAV/CardDAV service discovery.
    # Hand the probe to Laravel, which redirects to the installed DAV root.
    RewriteRule ^\.well-known/(caldav|carddav)$ index.php [L]

    # Origin-root MCP OAuth discovery (/.well-known/oauth-*) falls through to
    # index.php with other unknown paths. Do not require /api for those URLs.

    # Never expose runtime internals, config, or source trees directly.
    RewriteRule ^(?:wgw-modules|wgw-private|wgw-content)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:wgw-src|src|resources|vendor|scripts|patches|config|public|packages)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:composer\.(?:json|lock)|package\.json|wgw-config(?:\.sample)?\.php|\.env)$ - [F,L,NC]

    # Copy Authorization into the env var Sabre's stack reads.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . index.php [L]
</IfModule>
